# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Hive Metastore DB
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=metastore

# Airflow metadata DB (created by docker/postgres/init.sql)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# ─── Spark ────────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g

# ─── Airflow ──────────────────────────────────────────────────────────────────
# Generate Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# JWT secret for Airflow 3.0 LocalExecutor execution API (AIP-72)
# Must be identical on airflow-webserver AND airflow-scheduler
# Can reuse the same value as FERNET_KEY above
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
